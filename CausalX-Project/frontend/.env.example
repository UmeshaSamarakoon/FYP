VITE_API_URL=http://127.0.0.1:8000
# Backward-compatible alias; optional
VITE_API_BASE_URL=http://127.0.0.1:8000

# Poll and timeout controls
VITE_ANALYSIS_POLL_MS=2000
VITE_ANALYSIS_TIMEOUT_MS=900000
VITE_ANALYSIS_STATUS_ERROR_TOLERANCE=6

# Request reliability tuning
VITE_API_REQUEST_TIMEOUT_MS=30000
VITE_API_UPLOAD_TIMEOUT_MS=600000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_BASE_MS=1200

# If async endpoint is unavailable, allow fallback to /analyze
VITE_ALLOW_DIRECT_FALLBACK=true
