# CFN_PROB_THRESH (leave empty to use the deployment-safe default / inferred-floor behavior)
CFN_PROB_THRESH=
CFN_RATIO_THRESH=0.8
CFN_MIN_SUSPICIOUS_SEGMENT_FRAMES=3
CFN_SMOOTH_WINDOW=5
CFN_CHUNK_SECONDS=10
CFN_CAUSAL_THRESH=0.6
CFN_REQUIRE_FLAG=false
CFN_ENABLE_SCM_CHECKS=false
CFN_USE_EMBEDDINGS=true
CFN_ENSEMBLE_MANIFEST_PATH=models/fakeavceleb_best_step46_multiseed_manifest.json
# Optional explicit override for the locked live-precompute tabular scorer.
# Leave unset to auto-use backend/models/fakeavceleb_runtimeparity_plus_balanced_tabular.joblib when present.
# CFN_VIDEO_LEVEL_TABULAR_SCORER_PATH=models/fakeavceleb_runtimeparity_plus_balanced_tabular.joblib
# Auto-enable the checked-in tabular scorer when present. Set to false to fall back to CFN-only video scoring.
CFN_VIDEO_LEVEL_USE_DEFAULT_TABULAR=true
# Auto-enable the clip-level Step46 ensemble when the checked-in manifest exists.
# Set to false to force the legacy threshold-rule-only path.
CFN_VIDEO_LEVEL_USE_DEFAULT_MANIFEST=true
# Optional explicit override for the clip-level ensemble runtime calibration JSON.
# Leave unset to use backend/models/fakeavceleb_best_step46_runtime_calibration.json when present.
# CFN_VIDEO_LEVEL_RUNTIME_CALIBRATION_JSON=models/fakeavceleb_best_step46_runtime_calibration.json
# Optional directory for saved one-row Step46 precompute artifacts created during live scoring.
# Leave unset to use backend/outputs/step46_precompute.
# CFN_VIDEO_LEVEL_PRECOMPUTE_DIR=outputs/step46_precompute
